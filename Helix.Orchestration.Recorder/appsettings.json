{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "MQTTnet": "Information"
      }
    }
  },
  "Recorder": {
    "BrokerHost": "localhost",
    "BrokerPort": 1883,
    "TopicFilters": [
      "helix/#"
    ],
    "ChannelCapacity": 4096,
    "FlushAfterRecordCount": 100,
    "FlushIntervalSeconds": 30
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "helix-recorder",
    "UseSsl": false
  }
}
