{
  "agentId": "agent-fh-01",
  "siteId": "lab-cambridge",
  "fumehoodId": "fh-01",
  "siteServerEndpoint": "https://helix-site.lab.local:5000",
  "mqtt": {
    "brokerHost": "mqtt.lab.local",
    "brokerPort": 8883,
    "useTls": true,
    "clientId": "agent-fh-01"
  },
  "cleipnir": {
    "connectionString": "Data Source=agent.db",
    "storeType": "SQLite"
  },
  "adapters": [
    {
      "adapterId": "pump-sim-py",
      "endpoint": "http://localhost:50051",
      "deviceIds": ["pump-01"],
      "healthCheckIntervalSeconds": 30
    }
  ],
  "deviceRegistry": {
    "syncFromSiteServer": true,
    "localFallbackPath": "device-registry.json"
  }
}
