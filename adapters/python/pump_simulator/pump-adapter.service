[Unit]
Description=Helix Pump Simulator Adapter
After=network.target

[Service]
Type=simple
User=helix
WorkingDirectory=/opt/helix/adapters/python/pump_simulator
ExecStart=/usr/bin/python3 /opt/helix/adapters/python/pump_simulator/pump_adapter.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
