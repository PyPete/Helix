<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Cleipnir.ResilientFunctions" Version="4.0.0" />
	<PackageReference Include="Grpc.AspNetCore" Version="2.*" />
	<PackageReference Include="Grpc.Net.Client" Version="2.*" />
	<PackageReference Include="MQTTnet" Version="4.*" />
	<PackageReference Include="OpenTelemetry" Version="1.*" />
	<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.*" />
	<PackageReference Include="Serilog.Extensions.Hosting" Version="8.*" />
	<PackageReference Include="Serilog.Formatting.Compact" Version="2.*" />
	<PackageReference Include="Serilog.Sinks.Console" Version="5.*" />
	<PackageReference Include="Serilog.Sinks.File" Version="5.*" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Helix.Orchestration.Contracts\Helix.Orchestration.Contracts.csproj" />
	<ProjectReference Include="..\Helix.Orchestration.Core\Helix.Orchestration.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Content Include="Configuration\agent-config.json">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<Content Include="Configuration\device-registry.json">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
  </ItemGroup>

</Project>
