<?xml version="1.0" encoding="utf-8"?>
<!--
  Solution-level NuGet config.
  The global GitLab feed PAT is expired, causing NU1301 errors in VS.
  All packages used by this solution are available on nuget.org.
  The GitLab feed is disabled here to keep VS restore clean.
-->
<configuration>
  <packageSources>
	<clear />
	<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
